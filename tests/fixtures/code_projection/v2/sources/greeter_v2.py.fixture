"""RAW_PYTHON_FIXTURE_BODY_V2: source bytes stay outside the projection batch."""


class Greeter:
    """Return deterministic greetings."""

    def greet(self, name: str) -> str:
        return f"hello, {name}!"


def build_greeter() -> Greeter:
    return Greeter()
